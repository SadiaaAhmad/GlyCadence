# ==============================================================================
# GlyCadence Environment Configuration Template
# Copy this file to `.env` and fill in your local values.
# NEVER commit `.env` to version control.
# ==============================================================================

# --- PostgreSQL (Minimum Version 15) ---
POSTGRES_USER=glycadence
POSTGRES_PASSWORD=replace_with_strong_local_password
POSTGRES_DB=glycadence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy connection URI (use `postgres` as host inside Docker Compose)
DATABASE_URL=postgresql+psycopg://glycadence:replace_with_strong_local_password@localhost:5432/glycadence

# --- Backend API ---
APP_ENV=development
APP_NAME=GlyCadence API
APP_VERSION=0.1.0
BACKEND_PORT=8010
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# --- Security & AI (Required for Day 2+ / Day 4+) ---
JWT_SECRET_KEY=replace_with_random_64_char_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=20
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
AGENT_EXECUTION_MODE=auto

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
